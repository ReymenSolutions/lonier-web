# Configuración de la tienda.
#   VPS:    setup.sh crea /etc/lonier/lonier.env a partir de este archivo. Edítalo ahí y corre: systemctl restart lonier
#   Local:  cp .env.example .env  y  node --env-file=.env server.js
# Si un valor tiene espacios, ponlo entre comillas dobles.

# ---------- Pagos ----------
# Mercado Pago → Tus integraciones → Credenciales → Access Token
# (usa el de prueba "TEST-..." mientras pruebas, y el de producción "APP_USR-..." al lanzar)
MP_ACCESS_TOKEN=
# Opcional. Mercado Pago → Tus integraciones → Webhooks → Clave secreta. Si la pones, se valida la firma de cada aviso.
MP_WEBHOOK_SECRET=

# Stripe → Developers → API keys → Secret key (sk_test_... para pruebas, sk_live_... en producción)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → tu endpoint → Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# PayPal → developer.paypal.com → Apps & Credentials → tu app (Sandbox para probar, Live para cobrar)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (pruebas) o live (cobros reales)
PAYPAL_ENV=sandbox
# Tu app → Webhooks → Add Webhook (CHECKOUT.ORDER.APPROVED y PAYMENT.CAPTURE.COMPLETED) → Webhook ID
PAYPAL_WEBHOOK_ID=

# ---------- Base de datos (pedidos e inventario) ----------
# upstash.com → Create Database (Redis, región us-east-1 o la más cercana) → pestaña REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Correos (https://resend.com) ----------
RESEND_API_KEY=
# A dónde te llegan los avisos de pedidos pagados.
ORDER_EMAIL_TO=
# Opcional. Remitente con tu dominio verificado en Resend, p. ej. "Lonier Skin <pedidos@lonier.mx>".
# Si lo configuras, también se envían correos de confirmación y de envío a tus clientes.
EMAIL_FROM=

# ---------- Panel de administración (/admin) ----------
ADMIN_PASSWORD=

# Dominio público de la tienda, sin "/" al final. Opcional: si se omite se usa el dominio de la petición.
SITE_URL=https://lonier.mx
